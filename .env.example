# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # 前端可用（受 RLS 限制）
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # 僅伺服器端，切勿暴露給瀏覽器

# 站台設定
NEXT_PUBLIC_SITE_URL=https://laiquan.co        # 產生對外連結（報價單/合約/付款/進度頁）用
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@你的官方帳號ID
NEXT_PUBLIC_CONTACT_EMAIL=lqtech2026@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=02-1234-5678

# 表單通知信（Resend）
RESEND_API_KEY=re_...                          # 僅伺服器端；resend.com 建立
LEAD_NOTIFY_EMAIL=lqtech2026@gmail.com         # 收通知信的信箱
# RESEND_FROM="萊乾資訊 <noreply@你的網域>"      # 驗證網域後改成自家寄件人
# LEAD_NOTIFY_FROM="萊乾資訊官網 <onboarding@resend.dev>"  # 預設即可

# 後台（/admin）
ADMIN_PASSWORD=                                # 僅伺服器端；後台登入密碼
ADMIN_SESSION_SECRET=                          # 僅伺服器端；session cookie 的 HMAC 簽章金鑰
CRON_SECRET=                                   # 僅伺服器端；cron 端點的 Bearer 授權

# AI 客服 / 報價（Gemini）
GEMINI_API_KEY=                                # 僅伺服器端

# 金流（PChomePay 支付連）
PCHOMEPAY_APP_ID=                              # 僅伺服器端
PCHOMEPAY_SECRET=                              # 僅伺服器端
PCHOMEPAY_SANDBOX=false                        # true=測試環境
PCHOMEPAY_PAY_TYPES=CARD,ATM                   # 逗號分隔；預設 CARD,ATM

# GitHub 開發進度（後台讀每案 repo 的進度）
GITHUB_TOKEN=github_pat_...                    # 僅伺服器端；fine-grained PAT，Contents + Metadata 唯讀
GITHUB_SYNC_HOURS=20                           # 幾小時後視為過期、cron 會重抓（預設 20）

# cron 跟進間隔（選填，皆有程式內預設值）
# QUOTE_FOLLOWUP_DAYS=3                        # 報價單寄出幾天未回覆就提醒
# LIFECYCLE_FOLLOWUP_DAYS=3                    # 合約/請款/驗收逾期幾天提醒
# REVISIT_DAYS=30                              # 結案幾天後寄回訪信
